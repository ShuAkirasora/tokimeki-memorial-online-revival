# Everything the server writes while it runs: logs, packet dumps, the character
# store, and the self-signed certificate generated on first start. None of it
# belongs in the repository, and runtime/certs/ holds a private key.
runtime/

# This machine's knobs: what it runs differently from stock (server/knobs.py).
# An operator's choice, not the program's, so a pull must never touch it.
config/

.venv/

__pycache__/
*.pyc
.DS_Store
